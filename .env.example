# Sketch — Environment Configuration
#
# Copy this file to .env and edit as needed.
# LLM credentials, Slack tokens, and WhatsApp pairing are configured
# through the web UI during onboarding — not in this file.

# Database
# Supported: sqlite (default), postgres
DB_TYPE=sqlite
SQLITE_PATH=./data/sketch.db
# DATABASE_URL=postgres://user:pass@localhost:5432/sketch
# Maximum PostgreSQL connections opened by this Sketch process.
# POSTGRES_POOL_MAX=5

# Server
DATA_DIR=./data
# CLAUDE_CONFIG_DIR and SKETCH_CONFIG_DIR default to ~/.claude and ~/.sketch.
# Only override for custom deployments (must be absolute paths, ~ is not expanded).
# CLAUDE_CONFIG_DIR=/data/.claude
# SKETCH_CONFIG_DIR=/data/.sketch
PORT=3000
LOG_LEVEL=info          # debug | info | warn | error
# Independent concurrency caps for user-triggered and scheduler-triggered agent executions.
# Each queue is FIFO and cannot block the other. Maximum process concurrency is the sum.
# MAX_CONCURRENT_INTERACTIVE_AGENT_RUNS=4
# MAX_CONCURRENT_SCHEDULED_AGENT_RUNS=4

# Files
# Per-file download cap (MB). Files larger than this are rejected at download.
# MAX_FILE_SIZE_MB=20
# Per-message aggregate cap (MB) on image attachments embedded inline as base64
# for native vision. Base64 blocks stay resident for the whole agent run, so this
# bounds peak memory (roughly this value x the sum of both agent concurrency limits). Images past
# the budget are still saved to the workspace and listed in the prompt so the agent
# can Read them with tools; they are just not embedded inline.
# MAX_ATTACHMENT_TOTAL_MB=30
# In dev, the Vite server proxies /api to http://localhost:${PORT} by default.
# Override the full target if your API runs elsewhere (e.g. a remote host):
# VITE_API_PROXY_TARGET=http://localhost:3000

# Public-facing base URL (required for OAuth redirects)
# e.g. https://sketch.yourcompany.com — no trailing slash
# BASE_URL=http://localhost:3000

# Slack mode
# socket (default): uses WebSocket via App-Level Token (self-hosted)
# http: receives events via HTTP POST (required for Marketplace apps)
# SLACK_MODE=socket
# SLACK_SIGNING_SECRET=              # Required when SLACK_MODE=http

# WhatsApp providers
# Defaults preserve current self-hosted behavior: Baileys for DMs and groups.
# WHATSAPP_DM_PROVIDER=baileys
# WHATSAPP_GROUP_PROVIDER=baileys    # baileys | none
# WHATSAPP_RUNTIME_MODE=inprocess     # inprocess | gateway
# WHATSAPP_GATEWAY_PORT=3901
# To route one-to-one DMs through Wati while keeping Baileys groups:
# WHATSAPP_DM_PROVIDER=wati
# WATI_API_ENDPOINT=https://live-mt-server.wati.io/<tenant-id>  # Tenant-qualified endpoint from Wati API docs.
# WATI_ACCESS_TOKEN=
# WATI_WEBHOOK_TOKEN=
# WATI_CHANNEL_PHONE_NUMBER=         # Optional, digits only or E.164 when multiple Wati numbers are connected.
# Configure one enabled Wati webhook row for this callback:
# ${BASE_URL}/whatsapp/wati/events?token=<WATI_WEBHOOK_TOKEN>
# Select Message Received, Session Message Sent v2, Sent Message is DELIVERED v2,
# Sent Message is READ v2, and Session message FAILED. Avoid the legacy non-v2
# delivery/read events unless a Wati tenant cannot emit v2.
# Authorization: Bearer <token> and x-wati-webhook-token are also accepted when a caller can send headers.
# For proactive Wati DMs, approve Wati templates and map them to Sketch logical keys
# (`whatsapp.magic_link`, `whatsapp.introduction`, `whatsapp.proactive_update`).
# See SELF_HOSTING.md for the admin API calls and parameter mapping format.
# Managed tenants can use the platform-owned shared number for DMs while keeping
# Baileys groups. The platform posts inbound DMs to:
# POST /api/system/whatsapp/managed/events with Authorization: Bearer <SYSTEM_SECRET>
# Outbound managed DMs call MANAGED_WHATSAPP_PLATFORM_URL for text and template
# sends. Template sends resolve Sketch logical keys through the local WhatsApp
# template mapping table before calling the platform.
# WHATSAPP_DM_PROVIDER=managed
# WHATSAPP_GROUP_PROVIDER=baileys
# MANAGED_WHATSAPP_PLATFORM_URL=https://app.getsketch.ai
# MANAGED_WHATSAPP_TENANT_TOKEN=
# Number of days of Baileys group history to persist during reconnect sync.
# WHATSAPP_HISTORY_LOOKBACK_DAYS=30
# Default WhatsApp group conversation slicing knobs. Per-group settings override these.
# WHATSAPP_SLICE_GAP_MINUTES=25
# WHATSAPP_SLICE_MAX_AGE_MINUTES=120
# WHATSAPP_SLICE_MAX_MESSAGES=50
# WHATSAPP_SALIENCE_BATCH_LIMIT=50
# WHATSAPP_EMISSION_REFRESH_DAYS=7
# Backfilled history is admitted through the existing connector/salience pipeline in bounded pages.
# WHATSAPP_BACKFILL_GRAPH_PAGE_MESSAGES=500
# WHATSAPP_BACKFILL_GRAPH_PAGE_TOKENS=20000
# WHATSAPP_BACKFILL_GRAPH_CYCLE_MESSAGES=1500
# WHATSAPP_BACKFILL_GRAPH_PENDING_SLICES_MAX=200
# WHATSAPP_BACKFILL_GRAPH_PENDING_FILES_MAX=500
# WHATSAPP_BACKFILL_GRAPH_OPEN_FACTS_MAX=5000
# Enables the hourly in-window keep-alive ping for Wati/managed WhatsApp DMs.
# WHATSAPP_WINDOW_KEEPALIVE_ENABLED=false

# Encryption (optional, recommended for shared Postgres deployments)
# 64 hex chars = 32 bytes for AES-256-GCM
# ENCRYPTION_KEY=

# System API (optional, enables PUT /api/system/slack/tokens)
# SYSTEM_SECRET=

# Managed mode (set by the management plane, not by self-hosted users)
# MANAGED_URL=https://app.getsketch.ai
# MANAGED_AUTH_SECRET=
# CONNECTOR_CREDENTIAL_SOURCE=local
# CANVAS_CREDENTIAL_PRIVATE_KEY_PEM=
# CANVAS_CREDENTIAL_PRIVATE_KEY_PATH=
# CANVAS_CREDENTIAL_PUBLIC_KEY_ID=

# PostHog LLM Analytics (optional, sends gen_ai spans to PostHog)
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://us.i.posthog.com

# Feature flags
# EXPERIMENTAL_FLAG=false       # Set to true to enable Files & Connections UI
# BIRTH_GATE_DRY_RUN=true       # When EXPERIMENTAL_FLAG=true, log project/product/team birth gates without enforcing
# SLACK_ENTITY_SYNC=false
# SLACK_ENTITY_SYNC_PUBLIC_CHANNELS=true
# SLACK_ENTITY_SYNC_USER_INFO_CAP=1000

# Zoho CRM OAuth (required when Zoho CRM connector is enabled)
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=

# Microsoft connectors
# Configure the shared Outlook/Teams Microsoft Entra app here, or save it from workspace settings.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# OUTLOOK_INITIAL_LOOKBACK_DAYS=365
# OUTLOOK_MAX_INFLIGHT=4
# TEAMS_INITIAL_LOOKBACK_DAYS=365
# TEAMS_MAX_INFLIGHT=4
# TEAMS_PROCESSING_LAG_MS=7200000

# Visual analysis tool for text-only LLM deployments
# VISION_ENABLED=false
# VISION_MODEL=xiaomi/mimo-v2.5
# OPENROUTER_API_KEY=sk-or-v1-...
# Optional complete OpenRouter model ID for natural-language automation creation and editing.
# Reuses the configured OpenRouter credentials; leave unset to preserve normal authoring behavior.
# AUTOMATION_AUTHORING_MODEL=anthropic/claude-sonnet-4.6
# Entity graph heuristics
# LLM_PROMOTION_THRESHOLD=2
# LLM_TASK_CORROBORATION_THRESHOLD=2
# FEATURE_AUTO_MINT_THRESHOLD=1
# CO_MENTION_CONTRIBUTES_TO_THRESHOLD=3
# FLOOR_RETRY_MAX_FILES_PER_DOMAIN=5000
# FEATURE_ARCHIVE_MIN_MENTIONS=2
# FEATURE_ARCHIVE_AGE_DAYS=30
# FEATURE_ARCHIVE_MAX_PER_RUN=1000
# GEMINI_MAX_RPM=60
# GEMINI_MAX_RETRIES=4

# Sync stale-fact reconciliation guard
# SYNC_MAX_RECONCILE_RATIO=0.5
# SYNC_ALLOW_LARGE_RECONCILE=false

# Bootstrap (managed seed, first boot only)
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD_HASH=
# BOOTSTRAP_SLACK_BOT_TOKEN=
